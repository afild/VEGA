# Configurações do VEGA
VEGA_DB_PATH=vega_contracts.db
CONTRACTS_STORAGE_DIR=app/data/storage/contracts
HOST=127.0.0.1
PORT=8005
DEBUG=false
LOG_LEVEL=INFO

# Segurança local e limites de ingestão
MAX_CONTRACT_FILE_SIZE_MB=25
MAX_DOCX_UNCOMPRESSED_SIZE_MB=100
MAX_EXTRACTED_TEXT_CHARS=1000000
ALLOWED_HOSTS=127.0.0.1,localhost
# Deixe vazio para operar apenas em mesma origem.
CORS_ALLOWED_ORIGINS=

# Insira a chave da Anthropic aqui ou defina-a no ambiente do sistema
ANTHROPIC_API_KEY=
# Opt-in explícito para enviar trechos do documento bruto ao provedor de LLM.
ALLOW_LLM_RAW_CONTRACT_TEXT=false
